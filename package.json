{
  "name": "afyaflow-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "npm test --prefix src/frontend",
    "test:unit": "tsx --test tests/backend/unit.test.ts tests/backend/lambda.unit.test.ts tests/backend/model.unit.test.ts tests/backend/mimic.unit.test.ts && npm run test:unit --prefix src/frontend",
    "test:integration": "tsx --test --test-concurrency=1 tests/backend/workflow.test.ts && npm run test:integration --prefix src/frontend",
    "dev:backend": "tsx src/backend/src/main.ts",
    "dev:db": "tsx scripts/local-postgres.ts",
    "db:migrate": "tsx src/backend/src/database/migrate.ts",
    "db:seed": "tsx src/backend/src/database/seed.ts",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start:backend": "node dist/src/backend/src/main.js",
    "test:backend": "tsx --test --test-concurrency=1 tests/backend/*.test.ts",
    "start:mcp": "tsx services/mcp/server.ts",
    "db:import:mimic": "tsx src/backend/src/database/import-mimic.ts",
    "dataset:export:mimic": "tsx src/backend/src/database/export-mimic.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@codegenie/serverless-express": "5.0.0",
    "@langchain/langgraph": "1.5.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/server-filesystem": "1.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "csv-parse": "7.0.3",
    "dotenv": "17.4.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/aws-lambda": "8.10.164",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
