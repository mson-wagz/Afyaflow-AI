DATABASE_URL=postgresql://afyaflow:replace-with-local-password@127.0.0.1:5432/afyaflow
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
# Use AWS_PROFILE locally or an IAM role on AWS. Never put AWS keys in the frontend.
# AWS_PROFILE=afyaflow
AGENT_TIMEOUT_MS=90000
AGENT_MAX_STEPS=8
DATABASE_SSL=false
# On AWS use DATABASE_SSL=true and DATABASE_CA_FILE pointing to the RDS CA bundle.
NODE_ENV=development
