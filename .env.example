DATABASE_URL=postgresql://afyaflow:replace-with-local-password@127.0.0.1:5432/afyaflow
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
AI_PROVIDER=bedrock
OPENAI_MODEL=gpt-4.1-mini
# For local OpenAI runs, set AI_PROVIDER=openai and add the key only to .env.
# OPENAI_API_KEY=
# Production EC2 reads a mounted file fetched from SSM SecureString.
# OPENAI_API_KEY_FILE=/run/secrets/openai-api-key
# Use AWS_PROFILE locally or an IAM role on AWS. Never put AWS keys in the frontend.
# AWS_PROFILE=afyaflow
AGENT_TIMEOUT_MS=90000
AGENT_MAX_STEPS=8
DATABASE_SSL=false
# On AWS use DATABASE_SSL=true and DATABASE_CA_FILE pointing to the RDS CA bundle.
NODE_ENV=development
# Lambda loads DATABASE_SECRET_ARN instead of a plaintext DATABASE_URL environment variable.
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:your-secret
# DATABASE_HOST=optional-private-rds-proxy-endpoint
# DATABASE_POOL_MAX=2
# AGENT_QUEUE_URL=https://sqs.region.amazonaws.com/account/queue
# See deploy/lambda/README.md.
