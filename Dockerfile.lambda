FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json tsconfig*.json ./
RUN npm ci
COPY src/backend ./src/backend
COPY src/shared ./src/shared
COPY services ./services
RUN npm run build:backend

FROM public.ecr.aws/lambda/nodejs:24
WORKDIR ${LAMBDA_TASK_ROOT}
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY src/backend/src/database/*.sql ./src/backend/src/database/
COPY services/mcp/protocols ./services/mcp/protocols
COPY data/mimic-iv-ed-demo-2.2 ./data/mimic-iv-ed-demo-2.2
# RDS certificate bundle; keep TLS verification enabled.
ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /opt/rds/global-bundle.pem
RUN chmod 644 /opt/rds/global-bundle.pem && chmod -R a-w services/mcp/protocols
ENV DATABASE_SSL=true DATABASE_CA_FILE=/opt/rds/global-bundle.pem
CMD ["dist/src/backend/src/lambda/api.handler"]
